{"format":"vvtab-style","id":"calendar","size":"1x2","style":{"id":"graphite","name":"石墨玻璃","css":":root{--surface:#18232bc2;--edge:#ffffff50;--ink:#f6f5f1;--muted:#d0d8dc;--accent:#f8c78e;--button:#282831}body{background:transparent;font-family:system-ui,sans-serif}#root{width:100%;height:100%;overflow:hidden;border-radius:7px;display:flex;flex-direction:column;justify-content:center;padding:12px;color:var(--ink);background:var(--surface);border:1px solid var(--edge);box-shadow:inset 0 1px #ffffff29}b,strong{font-variant-numeric:tabular-nums}small{color:var(--muted)}.accent{color:var(--accent)}.summary{display:flex;align-items:center;justify-content:space-between;gap:8px}.grid-days{display:grid;grid-template-columns:repeat(7,1fr);text-align:center;align-items:center;gap:1px;flex:1;min-height:0}.grid-days span{font-size:10px}.grid-days .today{background:var(--accent);color:var(--button);border-radius:50%}.weekday{opacity:.6}.weather-days{display:flex;justify-content:space-between;gap:5px;font-size:10px}.weather-days span{display:flex;flex-direction:column;gap:3px}.weather-days b{font-size:11px}#root{align-items:center;text-align:center;gap:8px}.summary{flex-direction:column;gap:8px}.date{font-size:37px}.grid-days{display:none}"},"permissions":[],"code":"function draw(){const d=new Date(),y=d.getFullYear(),m=d.getMonth(),day=d.getDate(),first=(new Date(y,m,1).getDay()+(settings.weekStartsMonday===false?0:6))%7,total=new Date(y,m+1,0).getDate(),week=settings.weekStartsMonday===false?['日','一','二','三','四','五','六']:['一','二','三','四','五','六','日'];let cells=week.map(w=>'<span class=\"weekday\">'+w+'</span>').join('');for(let i=0;i<42;i++){const n=i-first+1;cells+='<span class=\"'+(n===day?'today':'')+'\">'+(n>0&&n<=total?n:'')+'</span>'}root.innerHTML='<div class=\"summary\"><small class=\"heading\">'+y+'年'+(m+1)+'月</small><div class=\"date accent\"><b>'+String(day).padStart(2,'0')+'</b></div><small>'+new Intl.DateTimeFormat('zh-CN',{weekday:'long'}).format(d)+'</small></div><div class=\"grid-days\">'+cells+'</div>'}draw();setInterval(draw,60000);"}
