{"format":"vvtab-style","id":"weather","size":"2x2","style":{"id":"porcelain","name":"瓷白玻璃","css":":root{--surface:#f6f5f0ae;--edge:#ffffffdc;--ink:#242633;--muted:#4f5661;--accent:#665c9b;--button:#fff}body{background:transparent;font-family:system-ui,sans-serif}#root{width:100%;height:100%;overflow:hidden;border-radius:7px;display:flex;flex-direction:column;justify-content:center;padding:12px;color:var(--ink);background:var(--surface);border:1px solid var(--edge);box-shadow:inset 0 1px #ffffff29}b,strong{font-variant-numeric:tabular-nums}small{color:var(--muted)}.accent{color:var(--accent)}.summary{display:flex;align-items:center;justify-content:space-between;gap:8px}.grid-days{display:grid;grid-template-columns:repeat(7,1fr);text-align:center;align-items:center;gap:1px;flex:1;min-height:0}.grid-days span{font-size:10px}.grid-days .today{background:var(--accent);color:var(--button);border-radius:50%}.weekday{opacity:.6}.weather-days{display:flex;justify-content:space-between;gap:5px;font-size:10px}.weather-days span{display:flex;flex-direction:column;gap:3px}.weather-days b{font-size:11px}#root{justify-content:space-around}.temp{font-size:49px}.weather-days{border-top:1px solid var(--edge);padding-top:9px}"},"permissions":[],"code":"function show(data){if(data.error){root.innerHTML='<small>天气暂不可用</small><strong>'+data.error+'</strong>';return}const days=(data.days||[]).map(x=>'<span><small>'+x.day.slice(5)+'</small><b>'+x.high+'° / '+x.low+'°</b></span>').join('');root.innerHTML='<small>'+data.city+(data.stale?' · 上次数据':' · 当前天气')+'</small><strong class=\"temp accent\">'+data.temp+'°</strong><span>'+data.description+'</span><small class=\"detail\">湿度 '+data.humidity+'% · 风速 '+data.wind+' km/h</small><div class=\"weather-days\">'+days+'</div>'}window.addEventListener('message',e=>{if(e.source===parent&&e.data&&e.data.vvtabWeather)show(e.data.vvtabWeather)});root.innerHTML='<small>正在获取天气…</small>';parent.postMessage({vvtabComponent:'weather-request'},'*');"}
