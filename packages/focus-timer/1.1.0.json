{"format":"vvtab-component","api":2,"id":"focus-timer","version":"1.1.0","name":"专注计时","sizes":["2x1","2x2"],"permissions":[],"skins":[{"id":"mint","name":"薄荷玻璃","styles":{"2x1":"body{background:#103b39;color:#eafff8}#root{height:100%;display:flex;align-items:center;justify-content:space-around;gap:8px;padding:8px}b{font-size:26px;font-variant-numeric:tabular-nums}button{background:#51cdb4;color:#07332e;border:0;padding:6px 10px;border-radius:4px;cursor:pointer}","2x2":"body{background:#103b39;color:#eafff8}#root{height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:18px}b{font-size:46px;font-variant-numeric:tabular-nums}button{background:#51cdb4;color:#07332e;border:0;padding:9px 20px;border-radius:4px;cursor:pointer}"}},{"id":"paper","name":"浅色纸张","styles":{"2x1":"body{background:#eff3e7;color:#22534d}#root{height:100%;display:flex;align-items:center;justify-content:space-around;gap:8px;padding:8px}b{font-size:26px;font-variant-numeric:tabular-nums}button{background:#225e55;color:white;border:0;padding:6px 10px;border-radius:4px;cursor:pointer}","2x2":"body{background:#eff3e7;color:#22534d}#root{height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:18px}b{font-size:46px;font-variant-numeric:tabular-nums}button{background:#225e55;color:white;border:0;padding:9px 20px;border-radius:4px;cursor:pointer}"}}],"code":"let left=25*60,active=false;root.innerHTML='<b id=timer>25:00</b><button id=toggle>开始</button>';function draw(){document.getElementById('timer').textContent=String(Math.floor(left/60)).padStart(2,'0')+':'+String(left%60).padStart(2,'0')}document.getElementById('toggle').onclick=()=>{if(!left)left=25*60;active=!active;document.getElementById('toggle').textContent=active?'暂停':'开始';draw()};setInterval(()=>{if(active&&left>0){left--;draw();if(!left){active=false;document.getElementById('toggle').textContent='重来'}}},1000)"}
